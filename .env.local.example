# Vapi.ai API Key - https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here

# Vapi Phone Number ID - Die Telefonnummer, die dem Agent zugewiesen wird
VAPI_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook Secret (optional) - Zum Verifizieren von Vapi Webhooks
VAPI_WEBHOOK_SECRET=your_webhook_secret_here

# Base URL for webhooks (set to your Vercel URL in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# CalDAV-Kalender - ohne diese Werte werden vereinbarte Termine NICHT ins Kalender eingetragen!
# Server-URL des CalDAV-Anbieters (z.B. Nextcloud: https://cloud.example.com/remote.php/dav)
CALDAV_URL=your_caldav_server_url_here
# Optional: URL des konkreten Kalenders, falls der Account mehrere hat
CALDAV_CALENDAR_URL=your_caldav_calendar_url_here
CALDAV_USERNAME=your_caldav_username_here
CALDAV_PASSWORD=your_caldav_password_here
